{
  "manifest_version": 3,
  "name": "Summary AI Notes",
  "version": "1.2.0",
  "description": "Record a meeting, lecture, or any tab, transcribe it on your device, and get Claude-powered notes you can chat with.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Summary AI Notes"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "tabCapture",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}